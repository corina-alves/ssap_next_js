# Copie para .env.docker e TROQUE AS SENHAS. O .env.docker nunca vai para o repositório.

# Administrador do PostgreSQL (só para manutenção; a aplicação NÃO usa)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_SENHA_ADMIN
POSTGRES_DB=ssap

# Usuário da aplicação (criado na primeira subida por db/docker-init, sem superusuário)
APP_DB_USER=ssap_app
APP_DB_PASSWORD=TROQUE_SENHA_APP

# Aplicação — mesma senha de APP_DB_PASSWORD; "db" é o nome do serviço no compose
DATABASE_URL=postgres://ssap_app:TROQUE_SENHA_APP@db:5432/ssap

# Endereço público (usado nos links de definição de senha)
APP_URL=https://salasituacao.exemplo.sp.gov.br

# true atrás do proxy reverso que define X-Forwarded-For (recomendado em produção)
TRUST_PROXY=true

# Proxy corporativo para as APIs externas (descomente se houver)
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.exemplo:8080
