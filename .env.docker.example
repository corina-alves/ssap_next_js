# Produção: docker compose --env-file .env.docker ...
# Somente configurações não secretas. Não defina DATABASE_URL aqui.
APP_URL=https://seu-dominio.exemplo/ssap
APP_PORTA=3000
APP_VERSAO=local

# PostgreSQL existente. No Ubuntu host, use host.docker.internal.
# localhost apontaria para o container. Veja rede/pg_hba em DOCKER.md.
DB_HOST=host.docker.internal
DB_PORTA=5432
DB_NOME=ssap
DB_USUARIO=ssap_app
DB_SENHA_HOST_ARQUIVO=./secrets/app_db_password.txt

# Verifica certificado e hostname. Para banco local sem TLS,
# configure disable explicitamente, após avaliar a rede.
DB_SSL_MODE=verify-full
# DB_SSL_CA_ARQUIVO=/certs/postgres-ca.pem

TRUST_PROXY=true
SAISP_USUARIO=
# Opcional: monte como secret e informe o caminho, veja DOCKER.md.
# SAISP_SENHA_ARQUIVO=/run/secrets/saisp_password

# Proxy de saída para APIs, se necessário:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.exemplo:8080
# HTTP_PROXY=http://proxy.exemplo:8080
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
# NODE_EXTRA_CA_CERTS=/certs/ca-instituicao.pem
