# TRECHO para incluir no server HTTPS EXISTENTE (não cria nem substitui server).
# Instale o arquivo ssap-proxy.conf em /etc/nginx/snippets/ssap-proxy.conf
# e ajuste somente a porta do upstream se APP_PORTA não for 3000.
# Mantenha /ssap na URI: proxy_pass com barra removeria o prefixo.
location = /ssap {
    include /etc/nginx/snippets/ssap-proxy.conf;
}
location ^~ /ssap/ {
    include /etc/nginx/snippets/ssap-proxy.conf;
}
# O token de definição de senha é sensível; não o grave no access log.
location = /ssap/acesso/redefinir-senha {
    access_log off;
    include /etc/nginx/snippets/ssap-proxy.conf;
}
